{
  "expo": {
    "owner": "jpvnk",
    "name": "infynii",
    "slug": "infynii",
    "version": "1.0.0",
    "scheme": "infynii",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jpvnk.infynii",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.jpvnk.infynii"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/abec6f34-250e-45d2-8249-a08114b6f349"
    },
    "extra": {
      "eas": {
        "projectId": "abec6f34-250e-45d2-8249-a08114b6f349"
      }
    },
    "plugins": [
      "expo-router",
      "expo-updates"
    ]
  }
}
